# Settings for docker-compose.yml (local development database only).
# Copy this file to .env and change the password.
# Use only letters and numbers in the password, so it works inside a URL.

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=portfolio

# Must match the values in the root .env used by docker-compose.yml
DATABASE_URL=postgres://portfolio:change-me-to-a-long-random-password@127.0.0.1:5432/portfolio