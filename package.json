{
  "name": "my-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "My Portfolio showing off deployed apps",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace=api --",
    "db:migrate": "npm run db:migrate --workspace=api --",
    "db:check": "npm run db:check --workspace=api",
    "db:seed": "npm run db:seed --workspace=api --",
    "admin:create": "npm run admin:create --workspace=api --",
    "test": "npm run test --workspaces --if-present",
    "test:int": "npm run test:int --workspace=api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsaronam/my-portfolio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wsaronam/my-portfolio/issues"
  },
  "homepage": "https://github.com/wsaronam/my-portfolio#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0"
  }
}
