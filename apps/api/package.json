{
    "name": "api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "typecheck": "tsc",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:check": "tsx --env-file-if-exists=.env scripts/check-db.ts",
        "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "pino-pretty": "^13.2.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.2"
    },
    "dependencies": {
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.12.7",
        "fastify-type-provider-zod": "^7.0.0",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    }
}
