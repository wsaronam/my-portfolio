# Copy this file to .env and adjust the values.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Must match the values in the root .env used by docker-compose.yml
DATABASE_URL=postgres://portfolio:change-me-to-a-long-random-password@127.0.0.1:5432/portfolio
# Integration tests empty this database before every test. Its name must end in _test.
TEST_DATABASE_URL=postgres://portfolio:change-me@127.0.0.1:5432/portfolio_test

APP_ORIGIN=http://localhost:5173